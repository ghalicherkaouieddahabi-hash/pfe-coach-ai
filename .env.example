# Copiez ce fichier en .env et renseignez votre clé API.
GEMINI_API_KEY=

# Modèle principal (éviter gemini-2.0-flash : quota gratuit souvent à 0)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-1.5-flash

# Pause entre chaque agent du pipeline (secondes)
GEMINI_DELAY_BETWEEN_AGENTS_SECONDS=3
GEMINI_MAX_RETRIES_ON_429=2
GEMINI_RETRY_CAP_SECONDS=55
